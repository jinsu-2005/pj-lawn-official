rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if the user is authenticated
    function isAuth() {
      return request.auth != null;
    }
    
    // Function to check if the user is an admin
    function isAdmin() {
      return isAuth() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // Function to check if the user is accessing their own document
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    match /bookings/{bookingId} {
      // Users can read their own bookings, admins can read all
      allow read: if isOwner(resource.data.userId) || isAdmin();
      
      // Users can create bookings as pending_review and unpaid
      allow create: if isAuth() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.bookingStatus == "pending_review"
        && request.resource.data.paymentStatus == "unpaid";
        
      // Only admins can update bookings (to approve/reject and set amounts)
      allow update: if isAdmin();
      
      // No one can delete bookings
      allow delete: if false;
    }
    
    match /availability/{dateId} {
      // Anyone can read date availability
      allow read: if true;
      
      // Admins can manage all availability
      allow write: if isAdmin();
      
      // Users can hold a date (create)
      allow create: if isAuth() 
        && request.resource.data.status == 'held'
        && request.resource.data.heldBy == request.auth.uid;
        
      // Users can update a hold if it belongs to them or if the hold has expired
      allow update: if isAuth()
        && request.resource.data.status == 'held'
        && request.resource.data.heldBy == request.auth.uid
        && (
          resource.data.heldBy == request.auth.uid 
          || resource.data.heldUntil < request.time
        );
        
      // Only admins can delete availability (for unblocking dates)
      allow delete: if isAdmin();
    }
    
    match /settings/{settingId} {
      // Anyone can read settings (pricing tiers, venue hours)
      allow read: if true;
      // Only admins can modify settings
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      // Users can check their own admin status
      allow read: if isOwner(adminId);
      // Only admins can modify the registry
      allow write: if isAdmin();
    }

    match /gallery/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
